# Configuration pour le système de traduction Ewondo
# Copiez ce fichier en .env et ajoutez votre clé API

# OpenAI API Key pour la traduction automatisée
# Obtenez votre clé sur: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Configuration optionnelle
# OPENAI_MODEL=gpt-4
# TRANSLATION_BATCH_SIZE=5

# ─── Google Search Console ────────────────────────────────────────────────────
# Code de vérification Google Search Console (méthode balise HTML).
# Obtenez votre code sur : https://search.google.com/search-console
# Dans GSC > Ajouter une propriété > Préfixe d'URL > Balise HTML
# Copier uniquement la valeur content="XXXXXXXXXXXXXXXXXXXXXXXXXX"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="cEPo12aXjyC23LUWCtKT45Ru_Wbnf9_prpRsRKRWsik"

# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# ID de mesure GA4 (format : G-XXXXXXXXXX)
# Obtenez votre ID sur : https://analytics.google.com
# À configurer lorsque le compte GA4 sera créé
NEXT_PUBLIC_GA_MEASUREMENT_ID=